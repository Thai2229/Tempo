# keyauth HTTP API settings (no secrets here; copy to .env or export in the shell)
KEYAUTH_CHECKPOINT=checkpoints/model.pt
KEYAUTH_DB=keyauth.db
# 1 = use per-user thresholds from the checkpoint's params (opt-in)
KEYAUTH_PER_USER=0
# single-tenant demo: every request uses this app_id
KEYAUTH_APP_ID=default
# 1 = return score and threshold in /verify responses (debug only: helps attackers tune forgeries)
KEYAUTH_DEBUG_SCORES=0
# requests per window on /enroll and /verify, per client IP and per user_id (per process)
KEYAUTH_RATE_LIMIT=30/60s
# if set, DELETE /user needs "Authorization: Bearer <value>"; leave empty only for local demos
KEYAUTH_ADMIN_TOKEN=
KEYAUTH_HOST=127.0.0.1
KEYAUTH_PORT=8000
