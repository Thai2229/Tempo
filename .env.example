# tempo HTTP API settings (no secrets here; copy to .env or export in the shell)
TEMPO_CHECKPOINT=checkpoints/model.pt
TEMPO_DB=tempo.db
# 1 = use per-user thresholds from the checkpoint's params (default; global threshold if it has none), 0 = off
TEMPO_PER_USER=1
# single-tenant demo: every request uses this app_id
TEMPO_APP_ID=default
# 1 = return score and threshold in /verify responses (debug only: helps attackers tune forgeries)
TEMPO_DEBUG_SCORES=0
# requests per window on /enroll and /verify, per client IP and per user_id (per process)
TEMPO_RATE_LIMIT=30/60s
# DELETE /user always needs "Authorization: Bearer <value>"; empty = deleting users is refused. Use 16+ characters
TEMPO_ADMIN_TOKEN=
# 1 = serve the demo page at / (assets under /static); 0 = API only
TEMPO_SERVE_UI=1
# 1 = (with TEMPO_SERVE_UI=1) serve the public landing page at / and move the plain demo page to /demo; 0 = demo at /
TEMPO_LANDING=0
TEMPO_HOST=127.0.0.1
TEMPO_PORT=8000
# multi-site service (docs/SERVICE.md): 1 = mount /v1. Then TEMPO_TOKEN_KEY is required and the server refuses to
# start without it. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"  (32+ characters)
TEMPO_ENABLE_V1=0
TEMPO_TOKEN_KEY=
# requests per window on /v1/siteverify and /v1/tickets, per client IP and per site (per process)
TEMPO_SERVER_RATE_LIMIT=600/60s
